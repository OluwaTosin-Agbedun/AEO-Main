# ============================================================================
# AEO DCM CORRECTIONS — ISOLATED STAGING ENVIRONMENT TEMPLATE
# ============================================================================
# CRITICAL ISOLATION RULES:
#   1. NEVER point Staging to Production Firebase project `gen-lang-client-0961551337`
#      or Production Firestore database `aeo-database19`.
#   2. Setting VITE_APP_ENV="staging" activates a runtime guard in src/lib/firebase.ts
#      that throws a fatal error if Production projectId or databaseId is detected.
#   3. NEVER point Staging email delivery to `aeo@athenacentre.org` or real subscribers.
#   4. NEVER commit filled `.env.staging` files or private keys to Git.

# Activates runtime Staging -> Production write protection in src/lib/firebase.ts
VITE_APP_ENV="staging"

# Dedicated Staging Firebase Web App Configuration (separate GCP/Firebase project)
VITE_FIREBASE_API_KEY="<STAGING_FIREBASE_WEB_API_KEY>"
VITE_FIREBASE_AUTH_DOMAIN="<STAGING_FIREBASE_PROJECT_ID>.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="<STAGING_FIREBASE_PROJECT_ID>"
VITE_FIREBASE_STORAGE_BUCKET="<STAGING_FIREBASE_PROJECT_ID>.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="<STAGING_MESSAGING_SENDER_ID>"
VITE_FIREBASE_APP_ID="<STAGING_FIREBASE_WEB_APP_ID>"
VITE_FIREBASE_DATABASE_ID="<STAGING_FIRESTORE_DATABASE_ID>"

# Public URL of the isolated Vercel Preview / Staging deployment
APP_URL="https://<STAGING_VERCEL_PREVIEW_DOMAIN>"

# ============================================================================
# ISOLATED STAGING EMAIL ROUTING (NO REAL SUBSCRIBERS / NO PRODUCTION INBOX)
# ============================================================================
# Leave MS_* / SMTP_* / RESEND_API_KEY blank during automated Playwright QA so
# accidental submissions cannot deliver live email, OR bind ONLY to an internal
# IT sandbox mailbox (e.g. staging-qa-mailbox@<internal-domain>).
MS_TENANT_ID=""
MS_CLIENT_ID=""
MS_CLIENT_SECRET=""
MS_GRAPH_SENDER=""
DCM_BRIEF_RECIPIENT="staging-qa-only@example.invalid"

SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="AEO Staging QA <staging-qa-only@example.invalid>"

RESEND_API_KEY=""
