{
  "entities": {
    "subscriber": {
      "title": "Subscriber",
      "description": "An email subscriber for analytical updates and notifications",
      "type": "object",
      "properties": {
        "email": {
          "type": "string",
          "description": "User's subscriber email address",
          "maxLength": 128
        },
        "channels": {
          "type": "array",
          "description": "Notification channels selected by the user"
        },
        "subscribedAt": {
          "type": "string",
          "description": "Timestamp of the subscription"
        }
      },
      "required": ["email", "channels", "subscribedAt"]
    },
    "adminAccount": {
      "title": "AdminAccount",
      "description": "Observatory Administrator Account authorized by Owner",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Firebase Authentication UID of the administrator",
          "maxLength": 128
        },
        "email": {
          "type": "string",
          "description": "Administrator email address",
          "maxLength": 128
        },
        "role": {
          "type": "string",
          "description": "Assigned administrative role",
          "enum": ["Super Administrator", "Administrator"]
        },
        "status": {
          "type": "string",
          "description": "Account authorization status",
          "enum": ["Active", "Suspended", "Revoked"]
        },
        "grantedAt": {
          "type": "string",
          "description": "Timestamp when authorization was granted"
        },
        "grantedBy": {
          "type": "string",
          "description": "Identifier of the granting authority"
        },
        "notes": {
          "type": "string",
          "description": "Optional administrative notes",
          "maxLength": 500
        }
      },
      "required": ["uid", "email", "role", "status", "grantedAt", "grantedBy"]
    },
    "auditLog": {
      "title": "AuditLog",
      "description": "Security audit record of administrative operations",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique audit log identifier",
          "maxLength": 128
        },
        "timestamp": {
          "type": "string",
          "description": "Timestamp of the security event"
        },
        "actingUid": {
          "type": "string",
          "description": "UID of the acting user",
          "maxLength": 128
        },
        "actingEmail": {
          "type": "string",
          "description": "Email of the acting user",
          "maxLength": 128
        },
        "targetUid": {
          "type": "string",
          "description": "Target identifier of the operation",
          "maxLength": 128
        },
        "operation": {
          "type": "string",
          "description": "Name of the audited operation",
          "maxLength": 200
        },
        "status": {
          "type": "string",
          "description": "Result status of the operation",
          "enum": ["SUCCESS", "FAILED"]
        },
        "reason": {
          "type": "string",
          "description": "Optional failure reason",
          "maxLength": 500
        }
      },
      "required": ["id", "timestamp", "actingUid", "actingEmail", "targetUid", "operation", "status"]
    },
    "cmsDocument": {
      "title": "CmsDocument",
      "description": "CMS managed configuration and publication content records",
      "type": "object",
      "properties": {
        "items": {
          "type": "array",
          "description": "Array of publication or timeline records"
        },
        "config": {
          "type": "object",
          "description": "Configuration settings object"
        },
        "updatedAt": {
          "type": "string",
          "description": "ISO timestamp of the record update"
        }
      }
    },
    "dcmDailyPublication": {
      "title": "DcmDailyPublication",
      "description": "Individual Research-approved daily DCM publication document (one document per daily update for scalability and historical immutability)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "publicationFormat": { "type": "string", "enum": ["daily"] },
        "title": { "type": "string", "maxLength": 240 },
        "year": { "type": "integer" },
        "month": { "type": "integer" },
        "periodIndex": { "type": "integer" },
        "periodStart": { "type": "string", "maxLength": 32 },
        "periodEnd": { "type": "string", "maxLength": 32 },
        "reportingPeriodLabel": { "type": "string", "maxLength": 120 },
        "publicationDate": { "type": "string", "maxLength": 80 },
        "evidenceCutoffDate": { "type": "string", "maxLength": 120 },
        "assessmentDate": { "type": "string", "maxLength": 10 },
        "evidenceCutoffTimeWat": { "type": "string", "maxLength": 5 },
        "evidenceCutoffDateTimeWat": { "type": "string", "maxLength": 32 },
        "publishedAt": { "type": "string", "maxLength": 64 },
        "isQuietDay": { "type": "boolean" },
        "carriedForwardAllStates": { "type": "boolean" },
        "carriedForwardFromPublicationId": { "type": "string", "maxLength": 128 },
        "supersedesPublicationId": { "type": "string", "maxLength": 128 },
        "revisionNumber": { "type": "integer" },
        "approvalRecord": {
          "type": "object",
          "description": "Admin-recorded Research approval reference with recording administrator UID and timestamp",
          "properties": {
            "approved": { "type": "boolean" },
            "approvalReference": { "type": "string", "maxLength": 128 },
            "approvedByName": { "type": "string", "maxLength": 128 },
            "approvedAt": { "type": "string", "maxLength": 64 },
            "recordedByUid": { "type": "string", "maxLength": 128 },
            "recordedByEmail": { "type": "string", "maxLength": 128 },
            "recordedAt": { "type": "string", "maxLength": 64 },
            "verificationMode": { "type": "string", "enum": ["admin-recorded-reference"] },
            "notes": { "type": "string", "maxLength": 500 }
          },
          "required": ["approved", "approvedAt", "recordedByUid", "recordedAt"]
        },
        "methodologyVersion": { "type": "string", "maxLength": 64 },
        "revisionNote": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "enum": ["draft", "approved", "published"] },
        "isLatest": { "type": "boolean" },
        "isBaseline": { "type": "boolean" },
        "summary": { "type": "string", "maxLength": 10000 },
        "changesSummary": { "type": "string", "maxLength": 10000 },
        "supportingDocumentUrl": { "type": "string", "maxLength": 500 },
        "classifications": { "type": "object" },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" },
        "createdByUid": { "type": "string", "maxLength": 128 },
        "updatedByUid": { "type": "string", "maxLength": 128 }
      },
      "required": [
        "id",
        "publicationFormat",
        "title",
        "year",
        "month",
        "periodIndex",
        "periodStart",
        "periodEnd",
        "reportingPeriodLabel",
        "publicationDate",
        "evidenceCutoffDate",
        "assessmentDate",
        "evidenceCutoffTimeWat",
        "evidenceCutoffDateTimeWat",
        "methodologyVersion",
        "status",
        "isLatest",
        "summary",
        "classifications",
        "createdAt",
        "updatedAt",
        "createdByUid",
        "updatedByUid"
      ]
    },
    "dcmEvidence": {
      "title": "DcmEvidenceRecord",
      "description": "Structured Research-approved public evidence record linked to a state, optional incident, and published assessments (immutable once published)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "stateCode": { "type": "string", "maxLength": 2 },
        "stateName": { "type": "string", "maxLength": 64 },
        "incidentId": { "type": "string", "maxLength": 128 },
        "linkedPublicationIds": { "type": "array" },
        "title": { "type": "string", "maxLength": 240 },
        "publicDescription": { "type": "string", "maxLength": 5000 },
        "sourceName": { "type": "string", "maxLength": 200 },
        "sourcePublicationDate": { "type": "string", "maxLength": 10 },
        "sourceUrl": { "type": "string", "maxLength": 2048 },
        "documentReference": { "type": "string", "maxLength": 500 },
        "verificationStatus": {
          "type": "string",
          "enum": [
            "Verified by Research",
            "Corroborated (Multiple Sources)",
            "Official Document / Public Record",
            "Disputed — Under Research Review",
            "Unverified Lead (Private)"
          ]
        },
        "isDisputed": { "type": "boolean" },
        "disputedClaimNote": { "type": "string", "maxLength": 2000 },
        "institutionalResponse": { "type": "object" },
        "visibility": { "type": "string", "enum": ["public", "private"] },
        "status": { "type": "string", "enum": ["draft", "approved", "published"] },
        "approvalRecord": { "type": "object" },
        "supersedesEvidenceId": { "type": "string", "maxLength": 128 },
        "revisionNumber": { "type": "integer" },
        "publishedAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" },
        "createdByUid": { "type": "string", "maxLength": 128 },
        "updatedByUid": { "type": "string", "maxLength": 128 }
      },
      "required": [
        "id",
        "stateCode",
        "stateName",
        "linkedPublicationIds",
        "title",
        "publicDescription",
        "sourceName",
        "sourcePublicationDate",
        "verificationStatus",
        "isDisputed",
        "visibility",
        "status",
        "createdAt",
        "updatedAt",
        "createdByUid",
        "updatedByUid"
      ]
    },
    "dcmIncident": {
      "title": "DcmIncidentRecord",
      "description": "Parent incident record associating multiple chronological developments under a single Incident ID",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "stateCode": { "type": "string", "maxLength": 2 },
        "stateName": { "type": "string", "maxLength": 64 },
        "title": { "type": "string", "maxLength": 240 },
        "summary": { "type": "string", "maxLength": 5000 },
        "researchStatusLabel": { "type": "string", "maxLength": 120 },
        "firstReportedDate": { "type": "string", "maxLength": 10 },
        "linkedPublicationIds": { "type": "array" },
        "visibility": { "type": "string", "enum": ["public", "private"] },
        "status": { "type": "string", "enum": ["draft", "approved", "published"] },
        "approvalRecord": { "type": "object" },
        "supersedesIncidentId": { "type": "string", "maxLength": 128 },
        "revisionNumber": { "type": "integer" },
        "publishedAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" },
        "createdByUid": { "type": "string", "maxLength": 128 },
        "updatedByUid": { "type": "string", "maxLength": 128 }
      },
      "required": [
        "id",
        "stateCode",
        "stateName",
        "title",
        "summary",
        "researchStatusLabel",
        "firstReportedDate",
        "linkedPublicationIds",
        "visibility",
        "status",
        "createdAt",
        "updatedAt",
        "createdByUid",
        "updatedByUid"
      ]
    },
    "dcmIncidentDevelopment": {
      "title": "DcmIncidentDevelopment",
      "description": "Chronological dated development linked to a parent Incident ID with Research-supplied status and dated source references",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "incidentId": { "type": "string", "maxLength": 128 },
        "stateCode": { "type": "string", "maxLength": 2 },
        "developmentDate": { "type": "string", "maxLength": 10 },
        "title": { "type": "string", "maxLength": 240 },
        "approvedDescription": { "type": "string", "maxLength": 5000 },
        "researchStatusLabel": { "type": "string", "maxLength": 120 },
        "isRemedyOrFollowUp": { "type": "boolean" },
        "sourceReferences": { "type": "array" },
        "linkedEvidenceIds": { "type": "array" },
        "linkedPublicationIds": { "type": "array" },
        "visibility": { "type": "string", "enum": ["public", "private"] },
        "status": { "type": "string", "enum": ["draft", "approved", "published"] },
        "approvalRecord": { "type": "object" },
        "supersedesDevelopmentId": { "type": "string", "maxLength": 128 },
        "revisionNumber": { "type": "integer" },
        "publishedAt": { "type": "string", "maxLength": 64 },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" },
        "createdByUid": { "type": "string", "maxLength": 128 },
        "updatedByUid": { "type": "string", "maxLength": 128 }
      },
      "required": [
        "id",
        "incidentId",
        "stateCode",
        "developmentDate",
        "title",
        "approvedDescription",
        "researchStatusLabel",
        "sourceReferences",
        "visibility",
        "status",
        "createdAt",
        "updatedAt",
        "createdByUid",
        "updatedByUid"
      ]
    },
    "dcmPrivateNote": {
      "title": "DcmPrivateNoteRecord",
      "description": "Physically isolated confidential internal notes, contacts, and unverified leads accessible ONLY to authorised AEO administrators",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "targetType": { "type": "string", "enum": ["evidence", "incident", "development", "state-assessment"] },
        "targetId": { "type": "string", "maxLength": 128 },
        "stateCode": { "type": "string", "maxLength": 2 },
        "confidentialNotes": { "type": "string", "maxLength": 10000 },
        "confidentialContacts": { "type": "string", "maxLength": 5000 },
        "unverifiedLeads": { "type": "string", "maxLength": 10000 },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" },
        "createdByUid": { "type": "string", "maxLength": 128 },
        "updatedByUid": { "type": "string", "maxLength": 128 }
      },
      "required": [
        "id",
        "targetType",
        "targetId",
        "stateCode",
        "confidentialNotes",
        "createdAt",
        "updatedAt",
        "createdByUid",
        "updatedByUid"
      ]
    },
    "dcmEditorialHandover": {
      "title": "DcmEditorialHandoverRecord",
      "description": "Admin-only editorial handover audit record capturing immutable extracts generated from published Research-approved DCM editions for the newsletter and ClearPath (does not constitute new Research approval)",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "publicationId": { "type": "string", "maxLength": 128 },
        "publicationAssessmentDate": { "type": "string", "maxLength": 10 },
        "stateCode": { "type": "string", "maxLength": 2 },
        "stateName": { "type": "string", "maxLength": 64 },
        "incidentId": { "type": "string", "maxLength": 128 },
        "exportType": { "type": "string", "enum": ["website-summary", "newsletter-dcw", "clearpath-on-the-map"] },
        "preparedByUid": { "type": "string", "maxLength": 128 },
        "preparedByName": { "type": "string", "maxLength": 120 },
        "preparedByEmail": { "type": "string", "maxLength": 160 },
        "exportedAtIso": { "type": "string", "maxLength": 64 },
        "exportedAtWatLabel": { "type": "string", "maxLength": 120 },
        "handoverStatus": { "type": "string", "enum": ["prepared", "handed-over", "published-externally", "archived"] },
        "recipientTeam": { "type": "string", "maxLength": 160 },
        "permanentRecordUrl": { "type": "string", "maxLength": 2048 },
        "sourceApprovalReference": { "type": "string", "maxLength": 160 },
        "governanceNotice": { "type": "string", "maxLength": 400 },
        "hasEditorialDraftEdits": { "type": "boolean" },
        "snapshotPayload": { "type": "string", "maxLength": 40000 },
        "createdAt": { "type": "integer" },
        "updatedAt": { "type": "integer" },
        "createdByUid": { "type": "string", "maxLength": 128 },
        "updatedByUid": { "type": "string", "maxLength": 128 }
      },
      "required": [
        "id",
        "publicationId",
        "publicationAssessmentDate",
        "stateCode",
        "stateName",
        "exportType",
        "preparedByUid",
        "preparedByName",
        "exportedAtIso",
        "exportedAtWatLabel",
        "handoverStatus",
        "permanentRecordUrl",
        "sourceApprovalReference",
        "governanceNotice",
        "hasEditorialDraftEdits",
        "snapshotPayload",
        "createdAt",
        "updatedAt",
        "createdByUid",
        "updatedByUid"
      ]
    }
  },
  "firestore": {
    "/subscribers/{subscriberId}": {
      "schema": "subscriber",
      "description": "List of active email subscribers"
    },
    "/cms_admins/{adminId}": {
      "schema": "adminAccount",
      "description": "Observatory Administrator Directory authorized by the Owner"
    },
    "/cms_audit_logs/{logId}": {
      "schema": "auditLog",
      "description": "Audit trail of administrative operations"
    },
    "/cms/{documentId}": {
      "schema": "cmsDocument",
      "description": "CMS collections and documents for election data, reports, and timeline"
    },
    "/dcm_daily_publications/{publicationId}": {
      "schema": "dcmDailyPublication",
      "description": "Scalable collection of individual daily DCM updates (drafts/approved admin-only; published immutable and publicly readable)"
    },
    "/dcm_evidence/{evidenceId}": {
      "schema": "dcmEvidence",
      "description": "Scalable collection of structured DCM public evidence records (strictly published + public readable by visitors; immutable once published)"
    },
    "/dcm_incidents/{incidentId}": {
      "schema": "dcmIncident",
      "description": "Scalable collection of parent DCM incident records grouping multiple chronological developments (immutable once published)"
    },
    "/dcm_incident_developments/{developmentId}": {
      "schema": "dcmIncidentDevelopment",
      "description": "Scalable collection of dated developments associated with a parent Incident ID (immutable once published)"
    },
    "/dcm_private_notes/{noteId}": {
      "schema": "dcmPrivateNote",
      "description": "Admin-only isolated collection for confidential notes, contacts, and unverified leads (never publicly readable)"
    },
    "/dcm_editorial_handovers/{handoverId}": {
      "schema": "dcmEditorialHandover",
      "description": "Admin-only audit trail of editorial handovers generated from published DCM records for the daily newsletter and ClearPath"
    },
    "/reports/{reportId}": {
      "schema": "cmsDocument",
      "description": "Individual forensic audit reports"
    },
    "/publications/{publicationId}": {
      "schema": "cmsDocument",
      "description": "Observatory research briefs and publications"
    }
  }
}
