+        ].join('\n')
+      : `  <p>${escapeHtml(NOT_SUPPLIED_LABEL)}</p>`;
+
+  const html = [
+    `<section data-aeo-export="clearpath-on-the-map" data-publication-id="${escapeHtml(source.publicationId)}" data-state-code="${escapeHtml(source.stateCode)}">`,
