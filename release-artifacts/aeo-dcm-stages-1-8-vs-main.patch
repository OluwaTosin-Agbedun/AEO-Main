+    '',
+    '7. Institutional response:',
+    institutionalResponse,
+    '',
+    '8. Verified remedy or subsequent development:',
+    verifiedRemedyOrSubsequentDevelopment,
+    '',
+    '9. Source references:',
+    sourcesBlock,
+    '',
+    '10. Permanent state assessment URL:',
+    source.permanentStateAbsoluteUrl
